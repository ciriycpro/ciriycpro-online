	<script>
document.addEventListener("DOMContentLoaded", function() {
    const h1 = document.querySelector("h1")?.innerText.trim() || document.title.split(" - ")[0] || "Услуга";

    // === 1. <img> без alt ===
    document.querySelectorAll("img:not([alt])").forEach(img => {
        let alt = "";
        const src = (img.getAttribute("src") || "").toLowerCase();
        const parent = img.closest("a, div, li, figure") || {};
        const nearbyText = (parent.innerText || "").trim().split("\n")[0].substring(0, 120);

        if (src.includes("team") || src.includes("employee") || src.includes("photo")) {
            alt = nearbyText || "Сотрудники компании ДАС-групп плюс";
        }
        else if (src.includes("service") || src.includes("usluga")) {
            alt = nearbyText || h1;
        }
        else if (src.includes("icon") || src.includes("arrow") || src.includes("svg")) {
            img.setAttribute("alt", "");
            img.setAttribute("aria-hidden", "true");
            return;
        }
        else if (src.includes("logo")) {
            alt = "ДАС-групп плюс";
        }
        else if (src.includes("doc") || src.includes("review")) {
            alt = "Отзыв клиента";
        }
        else {
            alt = h1;
        }

        img.setAttribute("alt", alt);
        img.setAttribute("loading", "lazy");
    });

    // === 2. background-image с контентом → скрытый <img> + aria-describedby ===
    const bgElements = document.querySelectorAll("[style*=\"background-image\"]");
    bgElements.forEach(el => {
        const style = el.getAttribute("style") || "";
        const match = style.match(/url\(['"]?([^'"]+)['"]?\)/i);
        if (!match) return;
        const bgUrl = match[1].replace(/^\//, "/");

        // Пропускаем декоративные
        if (bgUrl.includes("pattern") || bgUrl.includes("texture") || bgUrl.includes("decor") || bgUrl.includes("bg")) {
            el.setAttribute("aria-hidden", "true");
            return;
        }

        // Ищем подпись
        const captionEl = el.querySelector(".personal_name, .title, h3, h4, p, .name") || 
                         el.closest("li, .block")?.querySelector("h3, h4, .name");
        const caption = (captionEl?.innerText || "").trim() || "Услуга";

        // Создаём ID
        const descId = "desc-" + Math.random().toString(36).substr(2, 9);
        const altText = caption.includes("Персонал") 
            ? caption.replace("Персонал", "Сотрудники").replace("на", "в") + " — иллюстрация"
            : caption + " — визуализация";

        // Скрытый <img> для скринридеров
        const hiddenImg = document.createElement("img");
        hiddenImg.src = bgUrl;
        hiddenImg.alt = altText;
        hiddenImg.setAttribute("aria-hidden", "true");
        hiddenImg.style.cssText = "position:absolute !important; left:-9999px !important; width:1px !important; height:1px !important; overflow:hidden !important;";

        // Добавляем подпись как aria-describedby
        const span = document.createElement("span");
        span.id = descId;
        span.textContent = caption;
        span.style.cssText = "position:absolute !important; left:-9999px !important;";

        el.setAttribute("aria-describedby", descId);
        el.setAttribute("role", "img");
        el.appendChild(hiddenImg);
        el.appendChild(span);
    });

    // === 3. Декоративные background-image ===
    document.querySelectorAll("[style*=\"background-image\"]:not([aria-describedby])").forEach(el => {
        const style = el.getAttribute("style") || "";
        const urlMatch = style.match(/url\(['"]?([^'"]+)['"]?\)/i);
        if (!urlMatch) return;
        const bgUrl = urlMatch[1].toLowerCase();

        if (bgUrl.includes("pattern") || bgUrl.includes("texture") || bgUrl.includes("decor") || 
            bgUrl.includes("icon") || !el.innerText.trim()) {
            el.setAttribute("aria-hidden", "true");
        }
    });

    // === 4. Декоративные <img> ===
    document.querySelectorAll("img").forEach(img => {
        const src = (img.getAttribute("src") || "").toLowerCase();
        if (src.includes("arrow") || src.includes("icon") || src.includes("decor") || 
            (src.includes("svg") && !src.includes("photo"))) {
            img.setAttribute("alt", "");
            img.setAttribute("aria-hidden", "true");
        }
    });
});
</script>



